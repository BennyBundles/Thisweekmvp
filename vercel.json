{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh scripts/build-tagj-preview.sh && node scripts/check-tagj-package.mjs",
  "outputDirectory": ".tagj-dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/preview",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/preview.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/full.html",
      "destination": "/full",
      "permanent": false
    },
    {
      "source": "/tagj.html",
      "destination": "/tagj",
      "permanent": false
    },
    {
      "source": "/artist.html",
      "destination": "/artist",
      "permanent": false
    },
    {
      "source": "/producer.html",
      "destination": "/producer",
      "permanent": false
    },
    {
      "source": "/creative.html",
      "destination": "/creative",
      "permanent": false
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/licensing.html",
      "destination": "/licensing",
      "permanent": false
    },
    {
      "source": "/network/index.html",
      "destination": "/network",
      "permanent": false
    },
    {
      "source": "/network/bsf-tone-066.html",
      "destination": "/network/bsf-tone-066",
      "permanent": false
    },
    {
      "source": "/network/t311y-demon-life.html",
      "destination": "/network/t311y-demon-life",
      "permanent": false
    },
    {
      "source": "/creative/index.html",
      "destination": "/creative",
      "permanent": false
    },
    {
      "source": "/creative/portfolio.html",
      "destination": "/creative/portfolio",
      "permanent": false
    },
    {
      "source": "/creative/case-bsf-tone-066.html",
      "destination": "/creative/case-bsf-tone-066",
      "permanent": false
    },
    {
      "source": "/creative/case-t311y-demon-life.html",
      "destination": "/creative/case-t311y-demon-life",
      "permanent": false
    },
    {
      "source": "/services/index.html",
      "destination": "/services",
      "permanent": false
    },
    {
      "source": "/beats/index.html",
      "destination": "/beats",
      "permanent": false
    },
    {
      "source": "/music/index.html",
      "destination": "/music",
      "permanent": false
    },
    {
      "source": "/catalogue/index.html",
      "destination": "/catalogue",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/full",
      "destination": "/full.html"
    },
    {
      "source": "/tagj",
      "destination": "/tagj.html"
    },
    {
      "source": "/artist",
      "destination": "/artist.html"
    },
    {
      "source": "/producer",
      "destination": "/producer.html"
    },
    {
      "source": "/creative",
      "destination": "/creative.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/licensing",
      "destination": "/licensing.html"
    },
    {
      "source": "/network",
      "destination": "/network/index.html"
    },
    {
      "source": "/network/bsf-tone-066",
      "destination": "/network/bsf-tone-066.html"
    },
    {
      "source": "/network/t311y-demon-life",
      "destination": "/network/t311y-demon-life.html"
    },
    {
      "source": "/creative/portfolio",
      "destination": "/creative/portfolio.html"
    },
    {
      "source": "/creative/case-bsf-tone-066",
      "destination": "/creative/case-bsf-tone-066.html"
    },
    {
      "source": "/creative/case-t311y-demon-life",
      "destination": "/creative/case-t311y-demon-life.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/beats",
      "destination": "/beats/index.html"
    },
    {
      "source": "/music",
      "destination": "/music/index.html"
    },
    {
      "source": "/catalogue",
      "destination": "/catalogue/index.html"
    }
  ],
  "headers": [
    {
      "source": "/tagj-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/tagj-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/tagj-data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
